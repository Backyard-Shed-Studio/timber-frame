{
  "name": "@backyard-shed-studio/timber-frame",
  "version": "1.0.0",
  "description": "Vue 3 component library for Backyard Shed Studio projects",
  "license": "MIT",
  "repository": "Backyard-Shed-Studio/timber-frame",
  "workspaces": [
    "playground"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "npm run dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "release": "npm run lint && npm run test && npm run prepack && changelogen --release && npm publish && git push --follow-tags",
    "lint": "vp lint .",
    "test": "vp test run",
    "test:watch": "vp test watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit",
    "prepare": "vp config"
  },
  "dependencies": {
    "@nuxt/kit": "^4.6.2"
  },
  "devDependencies": {
    "@backyard-shed-studio/the-pencil": "github:Backyard-Shed-Studio/the-pencil",
    "@nuxt/devtools": "^3.4.2",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.6.2",
    "@nuxt/test-utils": "^4.3.3",
    "@types/node": "latest",
    "changelogen": "^0.6.2",
    "nuxt": "^4.6.2",
    "typescript": "^6.0.3",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "^3.3.12"
  }
}
